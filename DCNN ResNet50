ed(_fill_chunk, jobs):\n            done += ok\n            all_bad.extend(bad)\n            if done % 10240 < chunk:\n                print(f\"  {done}/{n}\")\n\n    #! chỉ save meta khi mọi ảnh đều ghi được — sự tồn tại của META_PATH chính là cờ \"cache hợp lệ\" cho lần chạy sau\n    if all_bad:\n        raise RuntimeError(f\"{len(all_bad)} ảnh lỗi, vd: {all_bad[:3]}\")\n\n    np.save(META_PATH, np.array(names, dtype=object))\n    return {k: i for i, k in enumerate(names)}\n \n \n# ── chạy build ──\ncache_df = all_xray_df.dropna(subset=[\"path\"]).reset_index(drop=True)\nname2row = build_cache(\n    paths=cache_df[\"path\"].tolist(),\n    names=cache_df[\"Image Index\"].tolist(),\n    n_proc=4,\n)\n ","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-07T07:42:22.175019Z","iopub.execute_input":"2026-08-07T07:42:22.175351Z","iopub.status.idle":"2026-08-07T07:54:56.069761Z","shell.execute_reply.started":"2026-08-07T07:42:22.175311Z","shell.execute_reply":"2026-08-07T07:54:56.068815Z"}},"outputs":[{"name":"stderr","text":"libpng warning: iCCP: profile 'ICC Profile': 'GRAY': Gray color space not permitted on RGB PNG\n","output_type":"stream"},{"name":"stdout","text":"  10240/112120\n","output_type":"stream"},{"name":"stderr","text":"libpng warning: iCCP: profile 'ICC Profile': 'GRAY': Gray color space not permitted on RGB PNG\n","output_type":"stream"},{"name":"stdout","text":"  20480/112120\n  30720/112120\n  40960/112120\n  51200/112120\n  61440/112120\n  71680/112120\n  81920/112120\n  92160/112120\n  102400/112120\n","output_type":"stream"}],"execution_count":61},{"cell_type":"code","source":"print(len(all_image_paths))          # nếu ra 0 → glob không match được gì\nprint(all_xray_df['path'].notna().sum())   # số ảnh map được","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-07T07:54:56.074546Z","iopub.execute_input":"2026-08-07T07:54:56.076614Z","iopub.status.idle":"2026-08-07T07:54:56.095987Z","shell.execute_reply.started":